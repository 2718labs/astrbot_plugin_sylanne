{
  "name": "sylanne-archive-arc",
  "private": true,
  "version": "0.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vue-tsc --noEmit && vite build",

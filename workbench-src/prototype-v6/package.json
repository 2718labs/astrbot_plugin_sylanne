    "build:singlefile": "npm run build && node --experimental-strip-types scripts/build-singlefile.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "three": "0.186.1",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "6.0.2",
    "vite": "8.1.1",
    "vue-tsc": "3.3.5"
  }
}
